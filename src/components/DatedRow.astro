---
// "Role · Organisation ............ dates" — used for experience and education.
// An optional detail line sits underneath, spanning the full row.
interface Props {
  role: string;
  org: string;
  dates: string;
  detail?: string;
}
const { role, org, dates, detail } = Astro.props;
---

<li class="flex flex-wrap justify-between gap-x-4">
  <span><span class="font-medium">{role}</span><span class="text-muted"> · {org}</span></span>
  <span class="ml-auto font-mono text-[13px] leading-[1.9] whitespace-nowrap text-faint">{dates}</span>
  {detail && <p class="mt-1 mb-0 basis-full text-sm text-muted">{detail}</p>}
</li>
