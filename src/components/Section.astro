---
// A homepage section: small mono label on the left, content on the right.
// On narrow screens the label sits above the content.
interface Props {
  id?: string;
  label: string;
}
const { id, label } = Astro.props;
---

<section id={id} class="flex scroll-mt-8 flex-wrap gap-x-10 gap-y-4 border-t border-rule py-14">
  <h2 class="m-0 flex-[0_0_140px] font-mono text-[13px] leading-[1.9] font-medium text-faint">{label}</h2>
  <div class="min-w-0 flex-[999_1_420px]">
    <slot />
  </div>
</section>
