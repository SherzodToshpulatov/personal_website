---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <section class="pt-28 pb-10">
    <p class="m-0 font-mono text-[13px] text-faint">404</p>
    <h1 class="mt-4 mb-0 text-[2.25rem] leading-[1.15] font-semibold tracking-[-0.03em]">Nothing here.</h1>
    <p class="mt-4 text-muted">The page you’re looking for doesn’t exist, or it moved when the site was rebuilt.</p>
    <p class="mt-8"><a href="/">Back to the homepage</a></p>
  </section>
</Base>
